TELEGRAM_BOT_TOKEN=put-token-here
TELEGRAM_ALLOWED_USER_ID=123456789
CODEX_WORKDIR=/path/to/workdir
CODEX_TIMEOUT_SECONDS=1800
CODEX_LAST_MESSAGE_PATH=state/last-response.txt
DROP_PENDING_UPDATES_ON_START=false
TELEGRAM_PARSE_MODE=MarkdownV2
UPLOAD_RETENTION_HOURS=48
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_DEFAULT_LANGUAGE=ru
STT_COMMAND=.venv/bin/python scripts/transcribe_voice.py
CODEX_COMMAND=codex exec --dangerously-bypass-approvals-and-sandbox --sandbox danger-full-access --skip-git-repo-check -C /path/to/workdir -
CODEX_RESUME_COMMAND=codex exec resume --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check
